# Copy to ~/.config/fi-nautical-charts.env and point at this host's directories.
#
# All three paths are absolute and distinct. The archive is refreshed and
# renamed in place, so it must not be what is served.
#
# The work and published directories sit side by side, because the unit mounts
# the parent they share as a single volume. Publishing renames between them, and
# a rename cannot cross a mount point even when both sides are one filesystem --
# two volumes would fail at hour ten, on the step that matters most.
#
# CHARTS_IMAGE is what `./run image` builds. Nothing pulls it: if it is not on
# this host, build it here.

CHARTS_IMAGE=fi-nautical-charts
CHARTS_ARCHIVE=/srv/charts/archive
CHARTS_WORK=/srv/charts/work
CHARTS_DEST=/srv/charts/published
