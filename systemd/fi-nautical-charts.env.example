# Copy to ~/.config/fi-nautical-charts.env and point at this host's directories.
#
# All four are absolute. The three the pipeline takes must be distinct
# directories: the archive is refreshed and renamed in place and must not be
# what is served, and the work directory must share a filesystem with the
# destination so publishing can rename rather than copy across it.

CHARTS_REPO=/home/USER/fi-nautical-charts
CHARTS_ARCHIVE=/srv/charts/archive
CHARTS_WORK=/srv/charts/work
CHARTS_DEST=/srv/charts/published
