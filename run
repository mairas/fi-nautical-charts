#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Tooling for building Signal K MBTiles from Finnish open nautical charts.
#

set -o nounset
set -o pipefail
set -o errexit

PROJECT_ROOT=${0%/*}
if [[ $0 != $PROJECT_ROOT && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
readonly PROJECT_ROOT=$(pwd)

################################################################################
# Chart comparison

function ab {
  #@ A/B render chart sources for a bbox (default: Helsinki front)
  #@ Category: Compare
  uv run charts_ab.py "$@"
}

function serve {
  #@ Browse local MBTiles in a browser, several at once, on a basemap backdrop
  #@ Category: Compare
  uv run serve.py "$@"
}

################################################################################
# Download

function dl {
  #@ Download a Traficom chart layer to MBTiles (WMTS source, fill mode by default)
  #@ Category: Download
  uv run traficom_dl.py "$@"
}

function verify-coverage {
  #@ Check coverage mode against the full oracle, and the footprint against itself
  #@ Category: Download
  uv run verify_coverage.py "$@"
}

function refresh {
  #@ Delta-refresh a chart file via If-Modified-Since, then relabel it
  #@ Category: Download
  local f="$1"
  local layer; layer=$(sqlite3 "$f" "SELECT value FROM metadata WHERE name='wmts_layer'")
  [[ -n "$layer" ]] || { echo "no wmts_layer in $f"; return 1; }
  uv run traficom_dl.py --layer "$layer" --out "$f" --refresh
  python3 currency.py "$f" --rename
}

function currency {
  #@ Label a chart set from its recorded currency, rename fi-<layer>-<date>.mbtiles
  #@ Category: Download
  python3 currency.py "$@"
}

################################################################################
# Process

function strip-nodata {
  #@ Remove the opaque black off-sheet fill some layers serve (run before downscale)
  #@ Category: Process
  uv run strip_nodata.py "$@"
}

function downscale {
  #@ Rebuild lower zoom levels by anti-aliased downscaling from the deepest level
  #@ Category: Process
  uv run downscale.py "$@"
}

function native-zoom {
  #@ Report each layer's genuine native max zoom (upscale vs real detail)
  #@ Category: Process
  uv run native_zoom.py "$@"
}

################################################################################
# Publish

function publish {
  #@ Copy processed sets into the served directory and write the manifest
  #@ Category: Publish
  uv run publish.py "$@"
}

function pipeline {
  #@ Refresh every layer, reprocess what moved, and publish it
  #@ Category: Publish
  uv run --locked pipeline.py "$@"
}

function image {
  #@ Build the container image the monthly run executes in
  #@ Category: Publish
  # The commit is the only way the served manifest can name the code that made
  # it: the image carries no .git for publish.py to ask.
  docker build --build-arg REVISION="$(git describe --always --dirty)" \
    --tag fi-nautical-charts "$@" .
}

function relock {
  #@ Re-resolve the pinned dependencies of every script the pipeline runs
  #@ Category: Publish
  local s
  for s in pipeline.py traficom_dl.py strip_nodata.py downscale.py publish.py; do
    echo "locking $s"
    uv lock --script "$s"
  done
}

################################################################################
# Utility Commands

function test {
  #@ Run the test suite
  #@ Category: Utility
  # Named explicitly: a bare pytest collects the whole tree, including scratch
  # files and _local/, so a stray test elsewhere would fail the suite.
  uv run --with 'pytest>=8,<9' --with pillow --with numpy --with scipy \
    pytest test_publish.py test_index_page.py test_strip_nodata.py \
    test_downscale.py test_pipeline.py "$@"
}

function deps {
  #@ Report tool dependencies
  #@ Category: Utility
  echo "Python tooling runs via uv (PEP 723 inline deps); no manual install needed."
  command -v uv >/dev/null && echo "uv: $(uv --version)" || echo "uv: NOT FOUND — install from https://docs.astral.sh/uv/"
}

function clean {
  #@ Remove rendered output
  #@ Category: Utility
  rm -rf out/
  echo "Removed out/"
}

################################################################################
# Help System

function help {
  #@ Show this help message
  #@ Category: Core
  echo "fi-nautical-charts - Development Commands"
  echo "========================================"
  echo ""

  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n" cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "  %-25s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
  echo ""
}

################################################################################
# Commands end.

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
